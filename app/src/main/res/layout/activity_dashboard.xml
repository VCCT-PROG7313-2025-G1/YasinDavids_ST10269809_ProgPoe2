<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Dashboard">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" >

        </FrameLayout>

        <!-- navbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_alignParentBottom="true"
            android:background="#588157"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:paddingStart="10dp"
                android:textColor="#000000"
                android:textSize="12sp"
                android:drawableTop="@drawable/bullet_list__points_bullet_unordered_list_lists_bullets"
                android:gravity="center"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/transaction_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transactions"
                android:paddingStart="10dp"
                android:textColor="#000000"
                android:textSize="12sp"
                android:drawableTop="@drawable/bill_1__billing_bills_payment_finance_cash_currency_money_accounting"
                android:gravity="center"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/category_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Category"
                android:paddingStart="10dp"
                android:textColor="#000000"
                android:textSize="12sp"
                android:drawableTop="@drawable/bank__institution_saving_bank_payment_finance"
                android:gravity="center"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/txt_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/account_icon"
                android:gravity="center"
                android:paddingStart="10dp"
                android:text="Accounts"
                android:textColor="#000000"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txt_reports"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/graph_bar_increase__up_product_performance_increase_arrow_graph_business_chart__1_"
                android:gravity="center"
                android:paddingStart="10dp"
                android:text="Reports"
                android:textColor="#000000"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txt_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/horizontal_menu_circle__navigation_dots_three_circle_button_horizontal_menu"
                android:gravity="center"
                android:paddingStart="10dp"
                android:text="Settings"
                android:textColor="#000000"
                android:textSize="12sp" />

        </LinearLayout>

    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>