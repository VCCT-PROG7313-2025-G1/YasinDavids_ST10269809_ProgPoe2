<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:background="#344E41" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#588157">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="20dp"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="5dp"
            android:text="Add Transaction"
            android:textColor="@color/black"/>

    </LinearLayout>
    <Space
        android:layout_width="match_parent"
        android:layout_height="50dp" />

    <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:card_view="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        card_view:cardBackgroundColor="#344E41"
        card_view:cardCornerRadius="16dp"
        card_view:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Income/Expebse buttons -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <RadioGroup
                    android:id="@+id/transactionTypeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/toggle_background"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <RadioButton
                        android:id="@+id/rbIncome"
                        android:checked="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/toggle_selector_left"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="+ Income"
                        android:textColor="@color/white" />

                    <RadioButton
                        android:id="@+id/rbExpense"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/toggle_selector_right"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="- Expense"
                        android:textColor="@color/white" />
                </RadioGroup>
            </LinearLayout>

            <!-- Income Screen -->
            <LinearLayout
                android:id="@+id/incomeInputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Amount input-->
                <TextView
                    android:id="@+id/incomeAmtText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Amount"
                    android:textColor="#90FFFFFF"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/incomeAmount"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:background="#20FFFFFF"
                    android:inputType="numberDecimal"
                    android:paddingStart="8dp"
                    android:text="R"
                    android:textColor="#80FFFFFF"
                    android:textSize="16sp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="30dp" />


                <!-- Account input-->
                <TextView
                    android:id="@+id/accSelectText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="From which account"
                    android:textColor="#90FFFFFF"
                    android:textStyle="bold" />


                <Spinner
                    android:id="@+id/accountSelect"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:background="#20FFFFFF"
                    android:textColor="#80FFFFFF"
                    android:paddingStart="8dp"/>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="30dp" />


                <!-- Date input-->
                <TextView
                    android:id="@+id/incomeDateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:textColor="#90FFFFFF"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/incomeDateInput"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:background="#20FFFFFF"
                    android:inputType="none"
                    android:paddingStart="8dp"
                    android:textColor="#80FFFFFF"
                    android:textSize="16dp"
                    android:hint="Select Date" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="30dp" />


                <!-- Category input-->
                <TextView
                    android:id="@+id/categorySelectText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textColor="#90FFFFFF"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/categorySelect"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:background="#20FFFFFF"
                    android:textColor="#80FFFFFF"
                    android:paddingStart="8dp"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="30dp" />

                <!-- Description input-->
                <TextView
                    android:id="@+id/incomeDescripText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textColor="#90FFFFFF"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/incomeDescription"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:background="#20FFFFFF"
                    android:inputType="numberDecimal"
                    />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="30dp" />

                <Button
                    android:id="@+id/save_income_category_btn"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:text="Save"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:backgroundTint="#20FFFFFF"
                    android:elevation="2dp"
                    android:layout_marginTop="8dp"
                    />

            </LinearLayout>


            <!-- Expense Screen -->
            <LinearLayout
                android:id="@+id/expenseInputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Amount input-->
                <TextView
                    android:id="@+id/expenseAmtText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Amount"
                    android:textColor="#90FFFFFF"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/expenseAmount"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:background="#20FFFFFF"
                    android:inputType="numberDecimal"
                    android:paddingStart="8dp"
                    android:text="R"
                    android:textColor="#80FFFFFF"
                    android:textSize="16sp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="30dp" />


                <!-- Account input-->
                <TextView
                    android:id="@+id/accSelectTextExpense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="To which account"
                    android:textColor="#90FFFFFF"
                    android:textStyle="bold" />


                <Spinner
                    android:id="@+id/accountSelectExpense"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:background="#20FFFFFF"
                    android:textColor="#80FFFFFF"
                    android:paddingStart="8dp"/>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="30dp" />


                <!-- Date input-->
                <TextView
                    android:id="@+id/expenseDateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:textColor="#90FFFFFF"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/expenseDateInput"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:background="#20FFFFFF"
                    android:inputType="none"
                    android:paddingStart="8dp"
                    android:textColor="#80FFFFFF"
                    android:textSize="16dp"
                    android:hint="Select Date" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="30dp" />

                <!-- Description input-->
                <TextView
                    android:id="@+id/expenseDescripText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textColor="#90FFFFFF"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/expenseDescription"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:background="#20FFFFFF"
                    android:inputType="numberDecimal"
                    />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="30dp" />


                <Button
                    android:id="@+id/btnTakePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Take Photo"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#588157"
                    android:drawableLeft="@android:drawable/ic_menu_camera"
                    android:padding="12dp"
                    android:layout_marginTop="16dp"
                    />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="30dp" />

                <Button
                    android:id="@+id/save_expense_category_btn"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:text="Save"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:backgroundTint="#20FFFFFF"
                    android:elevation="2dp"
                    android:layout_marginTop="8dp"
                    />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
